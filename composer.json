{
    "name": "amjadiqbal/laralink",
    "description": "Local package development for Laravel: link a package from a local folder or a Git repository into your app with one artisan command (Composer path repository + symlink), see what is linked, and switch back to the Packagist release when you're done.",
    "keywords": [
        "laravel",
        "laravel-package",
        "package-development",
        "local-development",
        "composer",
        "path-repository",
        "symlink",
        "monorepo",
        "artisan",
        "artisan-command",
        "developer-tools",
        "git"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/amjadiqbal/laralink",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laralink/issues",
        "source": "https://github.com/amjadiqbal/laralink",
        "docs": "https://github.com/amjadiqbal/laralink#readme"
    },
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/process": "^7.2|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\Laralink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\Laralink\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\Laralink\\LaralinkServiceProvider"
            ],
            "aliases": {
                "Laralink": "AmjadIqbal\\Laralink\\Facades\\Laralink"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
